# ---- Server ----
PORT=3000
NODE_ENV=production

# ---- MongoDB ----
# Full connection string, e.g. a MongoDB Atlas SRV URI:
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/signal_intake?retryWrites=true&w=majority
# or a self-hosted / Railway / Render MongoDB instance:
# mongodb://user:password@host:27017/signal_intake
MONGODB_URI=mongodb://localhost:27017/signal_intake

# ---- Admin auth ----
# Plaintext password you will log in with at /admin/login.
# The server hashes this internally on every login attempt — it is never stored in plaintext anywhere but this env var.
ADMIN_PASSWORD=change-me-to-something-strong

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ---- CORS ----
# The exact origin (scheme + host, no trailing slash) of your deployed survey page.
# e.g. https://my-signal-survey.vercel.app
ALLOWED_ORIGIN=https://REPLACE-WITH-YOUR-SURVEY-URL
