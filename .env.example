# ---- Server ----
PORT=3000
NODE_ENV=production

# ---- MongoDB ----
# Full connection string, e.g. a MongoDB Atlas SRV URI:
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/signal_intake?retryWrites=true&w=majority
# or a self-hosted / Railway / Render MongoDB instance:
# mongodb://user:password@host:27017/signal_intake
MONGODB_URI=mongodb://localhost:27017/signal_intake

# ---- Admin auth ----
# Plaintext password you will log in with at /admin/login.
# The server hashes this internally on every login attempt — it is never stored in plaintext anywhere but this env var.
ADMIN_PASSWORD=change-me-to-something-strong

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ---- CORS ----
# The exact origin (scheme + host, no trailing slash) of your deployed survey page.
# e.g. https://my-signal-survey.vercel.app
ALLOWED_ORIGIN=https://REPLACE-WITH-YOUR-SURVEY-URL

# ---- Optional: LLM-powered behavioral session summaries ----
# OFF by default. Can also be toggled at runtime from the admin dashboard's
# Sessions & Replay tab (that toggle resets on restart, so LLM_ENABLED here
# is the real "off by default" guarantee).
LLM_ENABLED=false

# 'ollama' (run a free/open-source model locally) or 'groq' (Groq's free-tier
# hosted API, also running open models like Llama).
LLM_PROVIDER=ollama

# --- Ollama (local) ---
# Install from https://ollama.com, then `ollama pull llama3.1:8b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Groq (free tier) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional custom system prompt for the summarizer. Leave blank to use the
# built-in default. A "do not guess visitor identity" instruction is always
# appended server-side regardless of what's set here.
LLM_SYSTEM_PROMPT=
